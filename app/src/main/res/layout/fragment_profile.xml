<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_header" android:gravity="center" android:orientation="vertical" android:paddingTop="56dp" android:paddingBottom="40dp">
        <TextView android:layout_width="96dp" android:layout_height="96dp" android:background="@drawable/bg_circle" android:gravity="center" android:text="👩‍⚕️" android:textSize="48sp"/>
        <TextView android:id="@+id/tvName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="#fff" android:textSize="24sp" android:textStyle="bold"/>
        <TextView android:id="@+id/tvRole" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#CCFBF1"/>
    </LinearLayout>
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="20dp" app:cardCornerRadius="20dp" app:cardElevation="3dp">
        <TextView android:id="@+id/tvEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:textColor="@color/ink" android:textSize="16sp"/>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.button.MaterialButton android:id="@+id/btnLogout" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginHorizontal="20dp" android:text="Log out" app:backgroundTint="@color/coral" app:cornerRadius="16dp"/>
</LinearLayout>
